{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ".............."
  },
  "Redis": {
    "ConnectionString": "localhost:....."
  },
  "JwtSettings": {
    "Secret" : "...................",
    "Issuer": "PitchReserveApi",
    "Audience": "PitchReserveApp",
    "ExpiryHours": 168
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "LoginLimitPerIp": 10,
    "RegistrationLimitPerIp": 5,
    "ReadLimitPerUserOrIp": 120,
    "WriteLimitPerUserOrIp": 30
  },
  "AllowedHosts": "*"
}
