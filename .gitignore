# ==============================================================================
# PitchReserve Production .gitignore
# Targeted for: .NET 8, JetBrains Rider, Visual Studio 2022, VS Code, & Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMPILATION & BUILD OUTPUTS (.NET / Roslyn / MSBuild)
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
dist/
artifacts/
bld/
[Bb]uild/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/

# Intermediate MSBuild files & compiler caches
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.sublime-*
*.cache
*.intermediate
*.incremental
*.class
*.tlog

# NuGet package cache folders (packages should be restored dynamically)
*.nuget.props
*.nuget.targets
packages/
*.nupkg
*.snupkg

# ------------------------------------------------------------------------------
# 2. TEST RESULTS & CODE COVERAGE
# ------------------------------------------------------------------------------
[Tt]est[Rr]esult*/
coverage/
CodeCoverage/
*.coverage
*.coveragexml
coverage.cobertura.xml
*.lcov
nunit-*.xml

# ------------------------------------------------------------------------------
# 3. JETBRAINS RIDER & RESHARPER ARTIFACTS
# ------------------------------------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.resharper.user
*.DotSettings.user
_TeamCity*

# ------------------------------------------------------------------------------
# 4. MICROSOFT VISUAL STUDIO ARTIFACTS
# ------------------------------------------------------------------------------
.vs/
.vsidx/
*.vcxproj.user
*.ide/
Generated\ Files/
msbuild.binlog
*.binlog

# ------------------------------------------------------------------------------
# 5. VISUAL STUDIO CODE ARTIFACTS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/

# ------------------------------------------------------------------------------
# 6. ENVIRONMENT VARIABLES & SECRETS (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
docker-compose.override.yml

# ASP.NET Core secrets and local configuration overrides
appsettings.local.json
appsettings.*.local.json
appsettings.Development.json
appsettings.Production.json
secrets.json

# ------------------------------------------------------------------------------
# 7. DATABASE & PERSISTENT STORAGE
# ------------------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dump.rdb
*.sql.bak
*.bak

# ------------------------------------------------------------------------------
# 8. OPERATING SYSTEM & SHELL ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
~$*
*~
*.tmp
*.swp
*#*
